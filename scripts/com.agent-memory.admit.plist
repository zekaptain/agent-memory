<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Opt-in only. Replace __MEM__ and __HOME__; see docs/admission-spec.md. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-memory.admit</string>
    <key>ProgramArguments</key>
    <array>
        <string>__MEM__</string>
        <string>--home</string>
        <string>__HOME__/.agent-memory</string>
        <string>--port</string>
        <string>9494</string>
        <string>admit</string>
        <string>run</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.agent-memory/admit.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.agent-memory/admit.log</string>
</dict>
</plist>
